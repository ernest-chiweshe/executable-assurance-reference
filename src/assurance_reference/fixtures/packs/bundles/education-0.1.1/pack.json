  "workflow": {
    "stages": [
      {
        "action": null,
        "id": "intake",
        "inputs": [
          "submission",
          "rubric"
        ],
        "outputs": [
          "submission"
        ],
        "trigger": "submission-received"
      },
      {
        "action": "education:draft-feedback",
        "effect": "reversible",
        "id": "pre-assess",
        "inputs": [
          "submission",
          "rubric"
        ],
        "outputs": [
          "feedback-draft",
          "card"
        ],
        "trigger": "stage:intake"
      },
      {
        "action": null,
        "id": "review",
        "inputs": [
          "feedback-draft",
          "card-feedback"
        ],
        "outputs": [
          "feedback"
        ],
        "trigger": "card-feedback"
      },
      {
        "action": "education:release-feedback",
        "effect": "external",
        "id": "release",
        "inputs": [
          "feedback",
          "approval"
        ],
        "outputs": [
          "release-receipt"
        ],
        "trigger": "stage:review"
      },
      {
        "action": "education:record-progress",
        "effect": "authoritative",
        "id": "progress",
        "inputs": [
          "release-receipt"
        ],
        "outputs": [
          "mastery-signal"
        ],
        "trigger": "stage:release"
      },
      {
        "action": null,
        "id": "retrieval",
        "inputs": [
          "mastery-signal"
        ],
        "outputs": [
          "re-attempt"
        ],
        "trigger": "schedule"
      }
    ]
