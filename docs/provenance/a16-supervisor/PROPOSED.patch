+def attempt_key(tenant_id: str, nonce: str) -> str:
+    """The opaque, tenant-free identity of one governance attempt, as a scope fence records it."""
+    return sha256(canonical_bytes({"tenant_id": tenant_id, "nonce": nonce})).hexdigest()
