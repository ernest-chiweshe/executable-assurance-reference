+-    def current(self, installation: str) -> GovernanceRoster | None: ...
+-
+-    def apply(self, change: GovernedChange) -> None: ...
+-
+-    def receipt(self, tenant_id: str, operation: str, nonce: str, change_digest: str) -> Outcome: ...
