+        done = {(e.tenant_id, e.nonce) for e in events if e.phase in (COMMITTED, NOT_COMMITTED)}
+        return next((attempt_key(e.tenant_id, e.nonce) for e in events
+                     if e.phase == PREPARED and (e.tenant_id, e.nonce) not in done), None)
